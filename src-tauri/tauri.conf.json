{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Scripture Journal",
  "version": "0.1.0",
  "identifier": "com.ernestchuang.scripture-journal",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "label": "main", "title": "Scripture Journal", "width": 1280, "height": 850, "minWidth": 420, "minHeight": 500, "visible": false, "backgroundColor": "#1d2420" }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' asset: http://asset.localhost data:; connect-src ipc: http://ipc.localhost https://bible-api.com"
    }
  },
  "bundle": { "active": true, "targets": "all", "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"] }
}
